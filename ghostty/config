# ═══════════════════════════════════════════════════════════
#  Ghostty — configuración
#  Docs: https://ghostty.org/docs/config
#  Se recarga automáticamente al guardar (hot reload)
# ═══════════════════════════════════════════════════════════

# ── Tema ────────────────────────────────────────────────────
theme = "Catppuccin Mocha"
background-opacity = 0.95
background-blur-radius = 25
window-theme = system

# ── Tipografía ──────────────────────────────────────────────
font-family = "JetBrains Mono Nerd Font"
font-size = 20
adjust-cell-height = 10%

# ── Ventana ─────────────────────────────────────────────────
macos-titlebar-style = hidden
window-padding-x = 14
window-padding-y = 12
window-width = 140
window-height = 42
macos-window-shadow = true
macos-option-as-alt = true

# ── Cursor ──────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Comportamiento ──────────────────────────────────────────
scrollback-limit = 10000
mouse-hide-while-typing = true
copy-on-select = true
confirm-close-surface = true
shell-integration = zsh

# ── Atajos (estilo VS Code / WezTerm) ───────────────────────
keybind = super+shift+enter=new_split:right
keybind = super+shift+backslash=new_split:down
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+alt+arrow_up=goto_split:top
keybind = super+alt+arrow_down=goto_split:bottom
keybind = super+ctrl+arrow_left=resize_split:left,5
keybind = super+ctrl+arrow_right=resize_split:right,5
keybind = super+ctrl+arrow_up=resize_split:up,5
keybind = super+ctrl+arrow_down=resize_split:down,5
keybind = super+shift+r=reload_config
# Quit the app (and drop its Dock icon) when its last window closes.
quit-after-last-window-closed = true
