#!/bin/bash
# SketchyBar — i3/Polybar-style top bar driven by AeroSpace.
source "$CONFIG_DIR/theme.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar position=top height=32 margin=10 y_offset=6 corner_radius=10 \
  color=$BAR_COLOR blur_radius=30 padding_left=6 padding_right=6 topmost=off

sketchybar --default \
  icon.font="$FONT:Bold:14.0" label.font="$FONT:Bold:13.0" \
  icon.color=$DARK label.color=$DARK \
  icon.padding_left=8 icon.padding_right=4 label.padding_left=4 label.padding_right=8 \
  background.height=24 background.corner_radius=6 \
  padding_left=3 padding_right=3

# ---------- Left: AeroSpace workspaces ----------
sketchybar --add event aerospace_workspace_change

for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change front_app_switched space_windows_change system_woke \
    --set "space.$sid" \
      icon="${WS_LABELS[$sid]}" \
      icon.font="$FONT:Bold:13.0" \
      label.font="sketchybar-app-font:Regular:14.0" \
      label.padding_right=10 \
      background.color=$PILL_BG \
      background.drawing=on \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

# ---------- Left: focused app ----------
sketchybar --add item front_app left \
  --subscribe front_app front_app_switched \
  --set front_app \
    icon.font="sketchybar-app-font:Regular:14.0" \
    background.color=$WHITE \
    padding_left=10 \
    script="$PLUGIN_DIR/front_app.sh"

# ---------- Right (first added = rightmost) ----------
sketchybar --add item clock right \
  --set clock icon="$ICON_CLOCK" background.color=$YELLOW update_freq=10 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item calendar right \
  --set calendar icon="$ICON_CALENDAR" background.color=$CYAN update_freq=60 \
    script="$PLUGIN_DIR/calendar.sh"

sketchybar --add item wifi right \
  --subscribe wifi wifi_change system_woke \
  --set wifi background.color=$PINK update_freq=30 \
    label.max_chars=14 \
    script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change \
  --set volume background.color=$CYAN \
    script="$PLUGIN_DIR/volume.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery background.color=$PINK update_freq=120 \
    script="$PLUGIN_DIR/battery.sh"

sketchybar --add item media right \
  --subscribe media media_change \
  --set media icon="$ICON_PLAY" background.color=$GREEN drawing=off \
    label.max_chars=28 scroll_texts=on \
    script="$PLUGIN_DIR/media.sh"

sketchybar --update
